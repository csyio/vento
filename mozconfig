# Vento build configuration. Usage: export MOZCONFIG=$PWD/mozconfig; cd engine; ./mach build
ac_add_options --enable-project=vento
ac_add_options --with-app-name=vento
ac_add_options --with-app-basename=Vento
# Bundle ID: com.cansoykanyilmaz.vento (helper apps: com.cansoykanyilmaz.vento-gpu-helper etc.)
ac_add_options --with-distribution-id=com.cansoykanyilmaz
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-vento

ac_add_options --enable-bootstrap
ac_add_options --disable-debug
ac_add_options --enable-optimize
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
# Updater ON: channel 'vento' only accepts our own MAR signature (patches/0003; docs/YAYIN.md)
ac_add_options --enable-updater
ac_add_options --enable-update-channel=vento
