# Vento application directory. NO dependency on Firefox's browser/ directory. That's a rule.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

DIRS += [
    "actors",
    "base",
    "components",
    "app",
    "locales",
]

# App locale source (branding/brand.ftl lives here). In Firefox, browser/l10n-registry.manifest does this;
# without it toolkit pages (error pages ...) can't find brand.ftl and no message resolves.
EXTRA_COMPONENTS += [
    "l10n-registry.manifest",
]

CONFIGURE_SUBST_FILES += ["installer/Makefile"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

# App preferences: app/profile/vento.js (no directives, so no preprocessing)
JS_PREFERENCE_FILES += [
    "app/profile/vento.js",
]
