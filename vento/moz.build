# Vento uygulama dizini. Firefox'un browser/ dizinine bağımlılık YOK — kural.

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

DIRS += [
    "actors",
    "base",
    "components",
    "app",
    "locales",
]

# Uygulama dil kaynağı (branding/brand.ftl burada). Firefox'ta browser/l10n-registry.manifest yapar;
# yoksa toolkit sayfaları (hata sayfaları …) brand.ftl'i bulamaz ve hiçbir ileti çözülmez.
EXTRA_COMPONENTS += [
    "l10n-registry.manifest",
]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

# Uygulama tercihleri: app/profile/vento.js (yönergesiz → ön işlemesiz)
JS_PREFERENCE_FILES += [
    "app/profile/vento.js",
]
