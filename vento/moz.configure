# Vento: a Gecko app independent of Firefox's browser/ directory.
# Path: --enable-project=vento (see ../mozconfig). Same model as Thunderbird (comm/mail).

imply_option("MOZ_PLACES", True)
imply_option("MOZ_APP_VENDOR", "Vento")
# Profile location (macOS: ~/Library/Application Support/<Profile>). Separate from the old browser's "Vento"
# directory and from real Firefox; to be decided again before release.
imply_option("MOZ_APP_PROFILE", "VentoNew")
imply_option("MOZ_APP_ID", "{ecbe259c-3069-4a3c-bc17-d534fbcb23a1}")
imply_option("BROWSER_CHROME_URL", "chrome://vento/content/vento.xhtml")

include("../toolkit/moz.configure")
