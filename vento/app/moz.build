# Vento main binary (macOS first). A simplified copy of nsBrowserApp.

if CONFIG["MOZ_MACBUNDLE_NAME"]:
    DIRS += ["macbuild/Contents"]

GeckoProgram(CONFIG["MOZ_APP_NAME"], linkage="standalone")

SOURCES += [
    "ApplicationData.cpp",
    "nsVentoApp.cpp",
]

DIST_SUBDIR = ""

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

if CONFIG["OS_ARCH"] == "Darwin":
    OS_LIBS += [
        "-framework CoreFoundation",
    ]

DisableStlWrapping()

if CONFIG["HAVE_CLOCK_MONOTONIC"]:
    OS_LIBS += CONFIG["REALTIME_LIBS"]
