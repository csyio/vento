# Vento's own UI strings are embedded in the code in Turkish; this directory only has the rules for packaging
# the engine's (toolkit/dom/netwerk/security) Turkish language files. See Makefile.in and tools/fetch-l10n.sh.

# Vento's own UI strings (Fluent). Each locale loads as Resources/browser/localization/<locale>/vento/vento.ftl
# (l10n source "5-vento", see l10n-registry.manifest). The set of ids must be the SAME in both languages (the self-test checks it).
FINAL_TARGET_FILES.localization["en-US"].vento += ["en-US/vento.ftl"]
FINAL_TARGET_FILES.localization["tr"].vento += ["tr/vento.ftl"]

