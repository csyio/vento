# Vento: packages the engine's Turkish (and later other) language files. This is Firefox's
# browser/locales/Makefile.in with the parts that depend on browser/ removed.
#
# Usage (wrapped by tools/build-locale.sh):
#   make -C obj-vento/vento/locales chrome-tr L10NBASEDIR=<firefox-l10n>

include $(topsrcdir)/config/config.mk

PWD := $(CURDIR)

include $(topsrcdir)/config/rules.mk

# Merged locale dir (same layout as toolkit/locales/l10n.mk; sub-makes read REAL_LOCALE_MERGEDIR from the environment)
BASE_MERGE := $(CURDIR)/merge-dir
export REAL_LOCALE_MERGEDIR = $(BASE_MERGE)/$(AB_CD)

# Builds a merged locale dir (REAL_LOCALE_MERGEDIR), filling missing strings from en-US.
# We use toolkit's configuration directly instead of Firefox's own l10n.mk, which expects $(srcdir)/l10n.toml.
merge-%: IS_LANGUAGE_REPACK=1
merge-%: AB_CD=$*
merge-%:
	$(RM) -rf $(REAL_LOCALE_MERGEDIR)
	$(PYTHON3) -m moz.l10n.bin.build --config $(topsrcdir)/toolkit/locales/l10n.toml --base $(L10NBASEDIR) --target $(BASE_MERGE) --locales $(AB_CD) --coverage

chrome-%: AB_CD=$*
chrome-%: IS_LANGUAGE_REPACK=1
chrome-%:
	@$(MAKE) merge-$*
	@$(MAKE) -C $(DEPTH)/toolkit/locales chrome-$*
	@$(MAKE) -C $(DEPTH)/$(MOZ_BRANDING_DIRECTORY)/locales chrome AB_CD=$*
